{% extends 'base.html.twig' %}

{% block title %}Subscribers | EMBER Admin{% endblock %}

{% block body %}
<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <img src="{{ asset('images/logo-cream%20white.png') }}" alt="EMBER" class="sidebar-logo">
            <span>ADMINISTRATION</span>
        </div>

        <nav class="sidebar-nav">
            <a href="{{ path('app_dashboard') }}" class="nav-link">Dashboard</a>
            <a href="{{ path('app_user_management') }}" class="nav-link">User Management</a>
            <a href="{{ path('app_product') }}" class="nav-link">Products</a>
            <a href="{{ path('app_order') }}" class="nav-link">Orders</a>
            <a href="{{ path('app_subscriber') }}" class="nav-link active">Subscribers</a>
            <a href="{{ path('app_message') }}" class="nav-link">Messages</a>
            <a href="{{ path('app_profile') }}" class="nav-link">My Profile</a>
        </nav>

        <div class="sidebar-bottom">
            <a href="{{ path('app_logout') }}" class="nav-link logout-link">Sign Out</a>
        </div>
    </aside>

    <main class="admin-main">
        <div class="management-heading">
            <div>
                <p class="eyebrow">Mailing List</p>
                <h1>Newsletter Subscribers</h1>
                <p>Manage people subscribed to EMBER updates.</p>
            </div>
            <span class="management-count">{{ subscribers|length }} Subscribers</span>
        </div>

        <div class="table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Email Address</th>
                        <th>Date Subscribed</th>
                    </tr>
                </thead>
                <tbody>
                    {% for subscriber in subscribers %}
                        <tr>
                            <td>{{ subscriber.email }}</td>
                            <td>
                                {{ subscriber.subscribedAt|date('M j, Y') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="empty-state">
                                No subscribers yet.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </main>
</div>
{% endblock %}
