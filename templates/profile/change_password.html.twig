{% extends 'base.html.twig' %}

{% block title %}Change Password | EMBER{% endblock %}

{% block body %}
<div class="admin-layout">

    {{ include('partials/_admin_sidebar.html.twig', {
        activePage: 'profile'
    }) }}

    <div class="admin-content admin-profile">

        <div class="profile-heading">
            <p class="profile-eyebrow">Account security</p>
            <h1>Change Password</h1>
            <p>Update your password to keep your account secure.</p>
        </div>

        {% for message in app.flashes('error') %}
            <div class="flash flash-error">{{ message }}</div>
        {% endfor %}

        <section class="profile-form-card" aria-labelledby="password-form-title">
            <div class="profile-form-heading">
                <p class="profile-eyebrow">Password security</p>
                <h2 id="password-form-title">Set a new password</h2>
                <p>Verify your current password, then choose a new one.</p>
            </div>

            {{ form_start(form, {'attr': {'class': 'profile-edit-form'}}) }}
                {{ form_errors(form) }}
                {{ form_errors(form.newPassword) }}

                {{ form_row(form.currentPassword, {'attr': {'autocomplete': 'current-password'}}) }}

                <p class="profile-password-note">
                    Use at least 12 characters for your new password.
                </p>

                {{ form_row(form.newPassword.first, {'attr': {'autocomplete': 'new-password'}}) }}
                {{ form_row(form.newPassword.second, {'attr': {'autocomplete': 'new-password'}}) }}

                <div class="profile-actions">
                    <button type="submit"
                            class="profile-button profile-button-primary">
                        Update Password
                    </button>

                    <a href="{{ path('app_profile') }}"
                       class="profile-button profile-button-outline">
                        Cancel
                    </a>
                </div>

            {{ form_end(form) }}
        </section>

    </div>
</div>
{% endblock %}
