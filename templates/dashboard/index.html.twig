{% extends 'base.html.twig' %}

{% block title %}Dashboard | EMBER Admin{% endblock %}

{% block body %}

<div class="admin-layout">

    {{ include('partials/_admin_sidebar.html.twig', {
        activePage: 'dashboard'
    }) }}

    <main class="admin-main">

        <header class="dashboard-header">
            <div>
                <p class="eyebrow">EMBER ADMINISTRATION</p>
                <h1>Dashboard</h1>
                <p class="dashboard-subtitle">
                    Welcome to your administration workspace.
                </p>
            </div>

            <div class="admin-user">
                <span>{{ app.user.username }}</span>
                <small>{{ isAdmin ? 'Administrator' : 'Staff' }}</small>
            </div>
        </header>

        <section class="dashboard-section">
            <h2>Overview</h2>

            <div class="dashboard-cards">

                {% if isAdmin %}
                    <article class="dashboard-card">
                        <span class="card-label">Total Users</span>
                        <h3>{{ totalUsers }}</h3>
                        <p>Registered accounts</p>
                    </article>

                    <article class="dashboard-card">
                        <span class="card-label">Total Staff</span>
                        <h3>{{ totalStaff }}</h3>
                        <p>Staff accounts</p>
                    </article>
                {% endif %}

                <article class="dashboard-card">
                    <span class="card-label">Total Products</span>
                    <h3>{{ totalProducts }}</h3>
                    <p>Products in the system</p>
                </article>

                <article class="dashboard-card">
                    <span class="card-label">Active Products</span>
                    <h3>{{ activeProducts }}</h3>
                    <p>Currently available products</p>
                </article>

                {% if isAdmin %}
                    <article class="dashboard-card">
                        <span class="card-label">Total Orders</span>
                        <h3>{{ totalOrders }}</h3>
                        <p>Customer orders</p>
                    </article>

                    <article class="dashboard-card">
                        <span class="card-label">Total Revenue</span>
                        <h3>₱{{ totalRevenue|number_format(2, '.', ',') }}</h3>
                        <p>Excluding cancelled orders</p>
                    </article>

                    <article class="dashboard-card">
                        <span class="card-label">Subscribers</span>
                        <h3>{{ totalSubscribers }}</h3>
                        <p>Newsletter subscribers</p>
                    </article>

                    <article class="dashboard-card">
                        <span class="card-label">Contact Messages</span>
                        <h3>{{ totalMessages }}</h3>
                        <p>Customer inquiries</p>
                    </article>
                {% endif %}

            </div>
        </section>

    </main>

</div>

{% endblock %}
