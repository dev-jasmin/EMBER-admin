
{% extends 'base.html.twig' %}

{% block title %}Add User | EMBER Admin{% endblock %}

{% block body %}

<div class="admin-layout">

    <aside class="admin-sidebar">

        <div class="sidebar-brand">
            <img
                src="{{ asset('images/logo-cream white.png') }}"
                alt="EMBER"
                class="sidebar-logo"
            >
            <span>ADMINISTRATION</span>
        </div>

        <nav class="sidebar-nav">
            <a href="{{ path('app_dashboard') }}" class="nav-link">
                Dashboard
            </a>

            <a href="{{ path('app_user_management') }}" class="nav-link active">
                User Management
            </a>

            <a href="{{ path('app_product') }}" class="nav-link">
                Products
            </a>
        </nav>

        <div class="sidebar-bottom">
            <a href="{{ path('app_logout') }}" class="nav-link logout-link">
                Sign Out
            </a>
        </div>

    </aside>

    <main class="admin-main">

        <div class="modal-overlay">

            <section class="admin-modal">

                <div class="modal-header">
                    <div>
                        <p class="eyebrow">ACCOUNT MANAGEMENT</p>
                        <h1>Add New User</h1>
                        <p class="dashboard-subtitle">
                            Create an administrator or staff account.
                        </p>
                    </div>

                    <a
                        href="{{ path('app_user_management') }}"
                        class="modal-close"
                        aria-label="Close"
                    >
                        &times;
                    </a>
                </div>

                {% for message in app.flashes('error') %}
                    <div class="flash flash-error" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}

                {{ form_start(form, {
                    attr: { class: 'admin-form' }
                }) }}

                    {{ form_errors(form) }}

                    {{ form_row(form.username) }}

                    {{ form_row(form.email) }}

                    {{ form_row(form.password) }}

                    {{ form_row(form.role) }}

                    <div class="modal-actions">
                        <a
                            href="{{ path('app_user_management') }}"
                            class="button button-secondary"
                        >
                            Cancel
                        </a>

                        <button
                            type="submit"
                            class="button button-champagne"
                        >
                            Create Account
                        </button>
                    </div>

                {{ form_end(form) }}

            </section>

        </div>

    </main>

</div>

{% endblock %}
