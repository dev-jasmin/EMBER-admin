{% extends 'base.html.twig' %}

{% block title %}User Management | EMBER Admin{% endblock %}

{% block body %}
<div class="admin-layout">

    {{ include('partials/_admin_sidebar.html.twig', {
        activePage: 'users'
    }) }}

    <main class="admin-main">
        <header class="dashboard-header">
            <div>
                <p class="eyebrow">EMBER ADMINISTRATION</p>
                <h1>User Management</h1>
                <p class="dashboard-subtitle">Manage administrator and staff accounts.</p>
            </div>

            <div class="admin-user">
                <span>{{ app.user.username }}</span>
                <small>Administrator</small>
            </div>
        </header>

        {% for message in app.flashes('success') %}
            <div class="flash flash-success" role="status">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="flash flash-error" role="alert">{{ message }}</div>
        {% endfor %}

        <section class="dashboard-section">
            <div class="management-heading">
                <div>
                    <h2>All Accounts</h2>
                    <p class="dashboard-subtitle">View and manage registered accounts.</p>
                </div>

                <button type="button" id="open-add-user-modal" class="button button-champagne">
                    + Add User
                </button>
            </div>

            <div class="table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Email Address</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Date Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.username }}</td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% for role in user.roles %}
                                        {% if role in ['ROLE_ADMIN', 'ROLE_STAFF', 'ROLE_CUSTOMER'] %}
                                            <span class="role-label">
                                                {{ role|replace({'ROLE_': ''})|title }}
                                            </span>
                                        {% endif %}
                                    {% endfor %}

                                    {% if user.roles is empty %}
                                        <span class="role-label">Customer</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if user.isActive %}
                                        <span class="user-status user-status--active">Active</span>
                                    {% else %}
                                        <span class="user-status user-status--inactive">Inactive</span>
                                    {% endif %}
                                </td>
                                <td>{{ user.createdAt|date('M d, Y') }}</td>

                                <td class="action-cell">
                                    <a
                                        href="{{ path('app_user_management_edit', {id: user.id}) }}"
                                        class="action-placeholder edit-action">
                                        Edit
                                    </a>

                                    {% if 'ROLE_STAFF' in user.roles and user.id != app.user.id %}
                                        <button
                                            type="button"
                                            class="action-placeholder status-action"
                                            data-status-url="{{ path('app_user_management_toggle_status', {id: user.id}) }}"
                                            data-user-name="{{ user.username }}"
                                            data-user-status="{{ user.isActive ? 'active' : 'inactive' }}"
                                            data-status-token="{{ csrf_token('toggle-user-status-' ~ user.id) }}">
                                            {{ user.isActive ? 'Deactivate' : 'Activate' }}
                                        </button>
                                    {% endif %}

                                    {% if user.id != app.user.id %}
                                        <button
                                            type="button"
                                            class="action-placeholder delete-action"
                                            data-delete-url="{{ path('app_user_management_delete', {id: user.id}) }}"
                                            data-user-name="{{ user.username }}"
                                            data-delete-token="{{ csrf_token('delete-user-' ~ user.id) }}">
                                            Delete
                                        </button>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="empty-table">No accounts found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

{# ADD USER MODAL #}
<div id="add-user-modal" class="modal-overlay" aria-hidden="true">
    <section class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="add-user-title">
        <div class="modal-header">
            <div>
                <p class="eyebrow">ACCOUNT MANAGEMENT</p>
                <h1 id="add-user-title">Add New User</h1>
            </div>

            <button type="button" id="close-add-user-modal" class="modal-close" aria-label="Close modal">
                &times;
            </button>
        </div>

        {{ form_start(form, {
            action: path('app_user_management'),
            attr: { class: 'admin-form' }
        }) }}
            {{ form_errors(form) }}
            {{ form_row(form.username) }}
            {{ form_row(form.email) }}
            {{ form_row(form.password) }}
            {{ form_row(form.role) }}

            <div class="modal-actions">
                <button type="button" id="cancel-add-user-modal" class="button button-secondary">
                    Cancel
                </button>
                <button type="submit" class="button button-champagne">
                    Create Account
                </button>
            </div>
        {{ form_end(form) }}
    </section>
</div>

{# EDIT USER MODAL #}
{% if editingUser is not null %}
<div id="edit-user-modal" class="modal-overlay is-open" aria-hidden="false">
    <section class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="edit-user-title">
        <div class="modal-header">
            <div>
                <p class="eyebrow">ACCOUNT MANAGEMENT</p>
                <h1 id="edit-user-title">Edit User</h1>
            </div>

            <a href="{{ path('app_user_management') }}" class="modal-close" aria-label="Close modal">
                &times;
            </a>
        </div>

        {{ form_start(editForm, {
            action: path('app_user_management_edit', {id: editingUser.id}),
            attr: { class: 'admin-form' }
        }) }}
            {{ form_errors(editForm) }}
            {{ form_row(editForm.username) }}
            {{ form_row(editForm.email) }}
            {{ form_row(editForm.role) }}
            {{ form_row(editForm.password) }}

            <div class="modal-actions">
                <a href="{{ path('app_user_management') }}" class="button button-secondary">
                    Cancel
                </a>
                <button type="submit" class="button button-champagne">
                    Save Changes
                </button>
            </div>
        {{ form_end(editForm) }}
    </section>
</div>
{% endif %}

{# DELETE CONFIRMATION MODAL #}
<div class="modal-overlay" id="deleteModal">
    <div class="admin-modal" role="dialog" aria-modal="true">
        <div class="modal-header">
            <h1>Delete Account</h1>
            <button type="button" class="modal-close" id="closeDeleteModal">&times;</button>
        </div>

        <p class="modal-description">
            Are you sure you want to delete <strong id="deleteUserName"></strong>?
        </p>
        <p class="modal-warning">This action cannot be undone.</p>

        <form method="post" id="deleteUserForm">
            <input type="hidden" name="_token" id="deleteUserToken">

            <div class="modal-actions">
                <button type="button" class="button button-secondary" id="cancelDelete">
                    Cancel
                </button>
                <button type="submit" class="button button-danger">
                    Delete Account
                </button>
            </div>
        </form>
    </div>
</div>

{# ACTIVATE / DEACTIVATE CONFIRMATION MODAL #}
<div class="modal-overlay" id="statusModal">
    <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="statusModalTitle">
        <div class="modal-header">
            <h1 id="statusModalTitle">Change Account Status</h1>
            <button type="button" class="modal-close" id="closeStatusModal">&times;</button>
        </div>

        <p class="modal-description" id="statusModalMessage"></p>

        <form method="post" id="statusUserForm">
            <input type="hidden" name="_token" id="statusUserToken">

            <div class="modal-actions">
                <button type="button" class="button button-secondary" id="cancelStatus">
                    Cancel
                </button>
                <button type="submit" class="button button-champagne" id="confirmStatus">
                    Confirm
                </button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {

    // ADD USER MODAL
    const modal = document.getElementById('add-user-modal');
    const openButton = document.getElementById('open-add-user-modal');
    const closeButton = document.getElementById('close-add-user-modal');
    const cancelButton = document.getElementById('cancel-add-user-modal');

    const showModal = {{ showModal ? 'true' : 'false' }};

    const openModal = () => {
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    };

    openButton.addEventListener('click', openModal);
    closeButton.addEventListener('click', closeModal);
    cancelButton.addEventListener('click', closeModal);

    modal.addEventListener('click', (event) => {
        if (event.target === modal) closeModal();
    });

    if (showModal) openModal();

    // EDIT USER MODAL
    const editModal = document.getElementById('edit-user-modal');

    if (editModal) {
        document.body.style.overflow = 'hidden';
    }

    // DELETE USER MODAL
    const deleteModal = document.getElementById('deleteModal');
    const deleteForm = document.getElementById('deleteUserForm');
    const deleteUserName = document.getElementById('deleteUserName');
    const deleteUserToken = document.getElementById('deleteUserToken');

    const closeDeleteButton = document.getElementById('closeDeleteModal');
    const cancelDeleteButton = document.getElementById('cancelDelete');

    const closeDeleteModal = () => {
        deleteModal.classList.remove('is-open');
        document.body.style.overflow = '';
    };

    document.querySelectorAll('.delete-action').forEach((button) => {
        button.addEventListener('click', () => {
            deleteForm.action = button.dataset.deleteUrl;
            deleteUserName.textContent = button.dataset.userName;
            deleteUserToken.value = button.dataset.deleteToken;

            deleteModal.classList.add('is-open');
            document.body.style.overflow = 'hidden';
        });
    });

    closeDeleteButton.addEventListener('click', closeDeleteModal);
    cancelDeleteButton.addEventListener('click', closeDeleteModal);

    deleteModal.addEventListener('click', (event) => {
        if (event.target === deleteModal) closeDeleteModal();
    });

    // ACTIVATE / DEACTIVATE MODAL
    const statusModal = document.getElementById('statusModal');
    const statusForm = document.getElementById('statusUserForm');
    const statusToken = document.getElementById('statusUserToken');
    const statusMessage = document.getElementById('statusModalMessage');
    const statusTitle = document.getElementById('statusModalTitle');
    const confirmStatus = document.getElementById('confirmStatus');

    const closeStatusButton = document.getElementById('closeStatusModal');
    const cancelStatusButton = document.getElementById('cancelStatus');

    const closeStatusModal = () => {
        statusModal.classList.remove('is-open');
        document.body.style.overflow = '';
    };

    document.querySelectorAll('.status-action').forEach((button) => {
        button.addEventListener('click', () => {
            const isActive = button.dataset.userStatus === 'active';
            const action = isActive ? 'deactivate' : 'activate';

            statusForm.action = button.dataset.statusUrl;
            statusToken.value = button.dataset.statusToken;

            statusTitle.textContent = isActive ? 'Deactivate Staff Account?' : 'Activate Staff Account?';

            statusMessage.textContent = isActive
                ? `Are you sure you want to deactivate ${button.dataset.userName}? They will no longer be able to log in.`
                : `Are you sure you want to reactivate ${button.dataset.userName}? They will be able to log in again.`;

            confirmStatus.textContent = isActive ? 'Deactivate Account' : 'Activate Account';

            statusModal.classList.add('is-open');
            document.body.style.overflow = 'hidden';
        });
    });

    closeStatusButton.addEventListener('click', closeStatusModal);
    cancelStatusButton.addEventListener('click', closeStatusModal);

    statusModal.addEventListener('click', (event) => {
        if (event.target === statusModal) closeStatusModal();
    });

    // ESCAPE KEY
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            closeModal();
            closeDeleteModal();
            closeStatusModal();
        }
    });
});
</script>
{% endblock %}
