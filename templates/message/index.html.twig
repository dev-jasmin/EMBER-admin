{% extends 'base.html.twig' %}

{% block title %}Messages | EMBER Admin{% endblock %}

{% block body %}
<div class="admin-layout">

    {{ include('partials/_admin_sidebar.html.twig', {
        activePage: 'messages'
    }) }}

    <main class="admin-main messages-page">
        <div class="management-heading">
            <div>
                <p class="eyebrow">Inbox</p>
                <h1>Contact Messages</h1>
                <p>Messages submitted through the EMBER contact form.</p>
            </div>
            <span class="management-count">{{ messages|length }} Messages</span>
        </div>

        <div class="message-list">
            {% for message in messages %}
                <article class="admin-message-card">
                    <div class="admin-message-header">
                        <div>
                            <strong>{{ message.name }}</strong>
                            <p>{{ message.email }}</p>
                        </div>

                        <div class="message-meta">
                            <span>{{ message.createdAt|date('M j, Y g:i A') }}</span>
                            <span class="status-badge {{ message.isRead ? 'status-read' : 'status-unread' }}">
                                {{ message.isRead ? 'Read' : 'Unread' }}
                            </span>
                        </div>
                    </div>

                    <h3 class="admin-message-subject">
                        {{ message.subject }}
                    </h3>

                    <p class="admin-message-body">
                        {{ message.message }}
                    </p>
                </article>
            {% else %}
                <div class="empty-state">
                    No contact messages yet.
                </div>
            {% endfor %}
        </div>
    </main>
</div>
{% endblock %}
